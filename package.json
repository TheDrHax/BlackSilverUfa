{
  "name": "blacksilverufa",
  "version": "1.0.0",
  "description": "Архив стримов BlackUFA",
  "private": true,
  "scripts": {
    "start": "webpack serve --host 0.0.0.0",
    "test": "jest",
    "postinstall": "patch-package --patch-dir src/js/patches"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheDrHax/BlackSilverUfa.git"
  },
  "keywords": [],
  "author": "TheDrHax <the.dr.hax@gmail.com>",
  "bugs": {
    "url": "https://github.com/TheDrHax/BlackSilverUfa/issues"
  },
  "homepage": "https://bsu.drhx.ru",
  "browserslist": [
    "defaults",
    "last 5 years"
  ],
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ],
    "plugins": [
      [
        "polyfill-corejs3",
        {
          "method": "usage-global"
        }
      ]
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "jsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.cache/"
    ],
    "moduleDirectories": [
      "node_modules",
      "src/js"
    ],
    "setupFilesAfterEnv": [
      "regenerator-runtime/runtime"
    ],
    "moduleNameMapper": {
      "data\\.\\prod$": "<rootDir>/src/js/data.dev.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/eslint-parser": "^8.1.2",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.3",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.2",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "bootstrap": "^5.3.9",
    "css-loader": "^7.1.5",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jest": "^30.5.2",
    "mini-css-extract-plugin": "^2.10.2",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.33",
    "postcss-loader": "^8.2.1",
    "react-refresh": "^0.19.0",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0"
  },
  "dependencies": {
    "@datapunt/matomo-tracker-js": "^0.5.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.0.0",
    "@fortawesome/free-regular-svg-icons": "^6.0.0",
    "@fortawesome/free-solid-svg-icons": "^6.0.0",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@vlsergey/react-bootstrap-pagination": "^3.2.1",
    "animated-scroll-to": "^2.2.0",
    "core-js": "^3.21.1",
    "history": "^4.10.1",
    "hls.js": "^1.4.5",
    "immutability-helper": "^3.1.1",
    "lodash": "^4.17.21",
    "lokijs": "^1.5.11",
    "minisearch": "^7.2.0",
    "plyr": "^3.7.7",
    "prop-types": "^15.7.2",
    "re-resizable": "^6.9.1",
    "react": "^18.3.1",
    "react-bootstrap": "^2.1.1",
    "react-bootstrap-typeahead": "^6.4.2",
    "react-click-away-listener": "^2.0.5",
    "react-custom-scroll": "^7.2.0",
    "react-date-picker": "^9.2.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.1.0",
    "react-measure": "^2.5.2",
    "react-responsive": "^10.0.1",
    "react-rnd": "^10.2.4",
    "react-router-dom": "^5.2.0",
    "regenerator-runtime": "^0.14.1",
    "shallowequal": "^1.1.0",
    "sugar-date": "^2.0.6",
    "use-query-params": "^2.2.2"
  }
}
