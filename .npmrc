# Several libraries declare React 16 peerDependencies while this app runs React 17
# (@vlsergey/react-bootstrap-pagination -> react ^16.0.0, @hypnosphi/create-react-context
# via react-bootstrap-typeahead). npm 6 ignored peer conflicts; npm 7+ fails resolution
# on them. legacy-peer-deps preserves the pre-npm-7 behaviour, i.e. exactly the tree that
# has been shipping. Removing this requires upgrading those libraries first.
legacy-peer-deps=true
