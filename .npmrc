# npm 12 strict peer resolution rejects some combinations that are verified to
# work at runtime:
#  - @babel/eslint-parser@8 declares peer eslint ^9|^10, while the project keeps
#    eslint@8 (eslint-config-airbnb has no flat-config version); the parser works
#    with eslint 8 in practice.
#  - eslint-config-airbnb@19 (eslintrc-only) requires eslint 8.
# Removing this requires migrating the lint stack to eslint 9+ flat config and an
# airbnb-compatible flat config preset.
legacy-peer-deps=true
